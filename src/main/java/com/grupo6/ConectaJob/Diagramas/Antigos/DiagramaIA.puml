@startumlUserTrabalhadorController --> UserTrabalhadorServiceUserTrabalhadorService --> ContratoServiceContratoService .> AIChatServiceInterfaceAIChatServiceInterface --|> OpenAIChatServiceInterfaceclass UserTrabalhadorController{+ verificarContrato(contrato, nomeVaga, empresaResponsavelCNPJ) : RetornoConferirVagaDTO}class UserTrabalhadorService{- ContratoService contratoService;+ verificarContrato(contrato, nomeVaga, empresaResponsavelCNPJ) : RetornoConferirVagaDTO}class ContratoService{- AIChatServiceInterface chatService;+ verificarContrato(contrato, nomeVaga, empresaResponsavelCNPJ) : RetornoConferirVagaDTO+ converterClasseParaJson(vagaParaConverter) : String+ converterContratoParaString(contrato) : String}interface AIChatServiceInterface{conferirVaga(contratoParaAnalisar, vagaParaAnalisar) : RetornoConferirVagaDTO}class OpenAIChatServiceInterface{- ChatClient chatClient;- String templateVagaParaAnalisar+ conferirVaga(contrato, vagaParaAnalisar) : RetornoConferirVagaDTO}@enduml